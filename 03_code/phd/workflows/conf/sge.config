// SGE / OGE 集群 profile。用法：nextflow run . -profile singularity,sge
process {
    executor = 'sge'
    queue    = params.queue ?: 'all.q'
    penv     = 'smp'                       // 并行环境名，以本集群 `qconf -spl` 的输出为准
    // -S /bin/bash 必须写：不写则 SGE 用默认 shell 执行作业脚本，
    // 里面的 bash 语法（source / 数组 / <<- heredoc）会直接语法错误。
    clusterOptions = '-S /bin/bash -cwd -V'
}

executor {
    queueSize       = 50
    submitRateLimit = '10/1min'
    pollInterval    = '30 sec'
}
