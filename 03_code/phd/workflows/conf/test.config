// 最小测试 profile：课堂上用它在几分钟内跑完 2–3 遍。
// 用法：python3 ../../master/pipelines/scripts/make_demo_data.py --outdir demo
//       nextflow run . -profile test,conda
params {
    samplesheet   = "${projectDir}/assets/samples.csv"
    transcriptome = "${projectDir}/demo/ref/transcripts.fa"
    salmon_kmer   = 21          // 演示转录本约 1500 bp，k=31 也能建（实测 exit 0）；21 只为教学提速。短于 k 的转录本会被 salmon 警告后静默跳过
    outdir        = 'results_test'
}

process {
    cpus   = 2
    memory = 4.GB
    time   = 30.min
}
