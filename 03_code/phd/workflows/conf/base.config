// 资源声明：只在这里出现，process 里只写 label。
// 好处：给集群加一档队列、把内存翻倍，都不必碰流程代码。

process {

    // 退出码 130–145 是被信号杀死（含 137 = OOM Kill、143 = SIGTERM 超时）；
    // 即信号 2..17 的经验区间；104 沿用 nf-core 模板惯例，官方文档无逐字定义。这类失败重试有意义，其余失败重试只是浪费机时。
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2

    // 动态资源：第 1 次不够，第 2 次给 2 倍，第 3 次给 3 倍。
    // 这是集群上跑大样本量最实用的一招——不必为最坏情况给所有任务申请峰值内存。
    withLabel: process_low {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withLabel: process_high {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    // withName 比 withLabel 优先级高：给单个 process 开小灶时用它。
    withName: 'SALMON_INDEX' {
        memory = { 16.GB * task.attempt }
    }
}
