// SLURM 集群 profile。用法：nextflow run . -profile singularity,slurm
process {
    executor = 'slurm'
    queue    = params.queue ?: 'cpu'
    // --export=NONE 让计算节点不继承登录 shell 的环境变量，
    // 避免「我本地 activate 过所以能跑」这种不可重复的假象。
    clusterOptions = '--export=NONE'
}

executor {
    queueSize       = 50        // 同时最多排 50 个作业，别把队列刷爆
    submitRateLimit = '10/1min' // 提交速率上限，防被调度器限流
    pollInterval    = '30 sec'
}
