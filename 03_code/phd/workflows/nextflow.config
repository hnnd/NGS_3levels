// ============================================
// 文件名称：nextflow.config
// 功能描述：p07 流程的全部可变参数、资源、执行器与容器配置
// 作者：王运生
// 日期：2026-08-29
// ============================================
//
// 配置分离原则：main.nf / modules/*.nf 里不出现任何具体路径、阈值、线程数、队列名。
// 换数据集 = 改 params；换集群 = 换 -profile。流程代码一行都不用动。

manifest {
    name            = 'ngs-phd-p07-quant'
    author          = '王运生'
    description     = '博士 p07 教学流程：fastp → salmon → 计数矩阵（Snakemake 版的 DSL2 等价物）'
    version         = '1.0.0'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
}

params {
    // ---- 输入 ----
    samplesheet    = "${projectDir}/assets/samples.csv"
    transcriptome  = null            // 必填，见 main.nf 的参数自检
    // ---- 输出 ----
    outdir         = 'results'
    publish_mode   = 'copy'          // copy / symlink / link；集群跨文件系统时用 copy
    // ---- 工具参数（审稿人问「你的阈值是多少」时，答案就在这里）----
    fastp_qual     = 20
    fastp_minlen   = 36
    fastp_extra    = '--detect_adapter_for_pe'
    salmon_libtype = 'A'
    salmon_kmer    = 31
    salmon_extra   = '--validateMappings --seqBias'
    // ---- 集群 ----
    queue          = null            // 由 -profile slurm/sge 或命令行 --queue 指定
    help           = false
}

includeConfig 'conf/base.config'

profiles {

    // 本机执行：默认。适合调试与小数据。
    standard {
        process.executor = 'local'
    }

    // 环境隔离：换 PATH。宿主的 glibc / 系统库仍是宿主的。
    conda {
        conda.enabled       = true
        conda.useMamba      = true
        conda.cacheDir      = "${projectDir}/.conda_cache"
        docker.enabled      = false
        singularity.enabled = false
    }

    // 容器：换整个用户态。镜像自带系统库，因此能解决 conda 解决不了的 GLIBC 类问题。
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'   // 否则产物属主是 root
        conda.enabled       = false
        singularity.enabled = false
    }

    // 集群上通常只有 Singularity/Apptainer：无守护进程、以本人身份运行、可直接拉 Docker 镜像。
    // 注意：它与 Docker 一样是**系统级运行时**，不在 ngs_phd_workflow 这个 conda 环境里。
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = "${projectDir}/.singularity_cache"
        conda.enabled          = false
        docker.enabled         = false
    }

    slurm { includeConfig 'conf/slurm.config' }
    sge   { includeConfig 'conf/sge.config'   }
    test  { includeConfig 'conf/test.config'  }
}

// ---- 执行报告：默认全开，重跑时覆盖同名文件 ----
// 想给某一次运行留存档，用命令行显式指名：
//   nextflow run . -with-report run1.html -with-trace run1.txt -with-dag run1.html
//
// 注意：配置文件里**不能声明 `def` 变量**（Nextflow 24+ 的严格解析器直接报
// "Variable declarations cannot be mixed with config statements"，见讲义 ⑨-1），
// 所以这里不能像 nf-core 老模板那样用一个 def 变量拼时间戳。
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html"   }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt"     }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.html"      }
